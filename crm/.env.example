# Copia este archivo como .env.local y rellena los valores reales.
# NO commitear nunca .env.local ni exponer claves secretas en el cliente.

# URL del proyecto Supabase: Dashboard > Project Settings > API > Project URL.
# Ejemplo: https://abcdefgh.supabase.co
NEXT_PUBLIC_SUPABASE_URL=

# Clave anónima (pública) del proyecto: Dashboard > Project Settings > API >
# anon public. Es safe para el navegador; RLS limita lo que puede leer.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Clave service_role (SECRETA): Dashboard > Project Settings > API >
# service_role. SOLO usarla en servidor (route handlers / server actions),
# nunca importarla en código cliente. Da acceso total saltándose RLS.
SUPABASE_SERVICE_ROLE_KEY=

# URL pública de la app (sin barra final). En desarrollo:
# http://localhost:3000. En producción: dominio desplegado.
# Se usa para links de email (magic links, invitaciones) y callbacks OAuth.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# API key de Resend para envío de emails. Se añade en Task 17 (emails).
# RESEND_API_KEY=
